    "import pandas as pd\n",
    "\n",
    "# 读取 tsv 文件（使用 '\\t' 作为分隔符）\n",
    "df = pd.read_csv('/home/yangzy/ibd_uc_project/tf_cd4_uc/adj.pbmc.tsv', sep='\\t')\n",
    "\n",
    "# 将相同 TF 对应的 target 值合并为逗号分隔的字符串\n",
    "df_grouped = df.groupby('TF')['target'].apply(lambda x: ','.join(x)).reset_index()\n",
    "\n",
    "# 生成目标格式\n",
    "df_grouped['reg_pbmc.TF'] = df_grouped['TF']\n",
    "df_grouped['FTILER'] = df_grouped['target']\n",
    "\n",
    "# 只保留需要的列并重新排序\n",
    "result = df_grouped[['reg_pbmc.TF', 'FTILER']]\n",
    "\n",
    "# 打印结果\n",
    "print(result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "792fe7c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "result = result.rename(columns={\n",
    "    'reg_pbmc.TF': 'TF',\n",
    "    'FTILER': 'Target_genes',\n",
    "    # 可以继续添加需要修改的列名\n",
    "})\n",
    "Paul_15_data = result"
   ]
